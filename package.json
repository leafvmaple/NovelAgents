{
  "name": "novel-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A small, inspectable multi-role novel writing agent.",
  "scripts": {
    "dev": "pnpm build && node dist/src/index.js",
    "demo": "pnpm build && node dist/src/index.js --demo --yes",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build && node --test dist/tests/*.test.js",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.150.1",
    "dotenv": "^16.6.1",
    "jsonrepair": "^3.15.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.0",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0"
  },
  "engines": {
    "node": ">=20"
  }
}
