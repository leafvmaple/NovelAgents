# OpenRouter provides an OpenAI-compatible endpoint. Create a key at:
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# The free router chooses an available free model for each request.
NOVEL_AGENT_MODEL=openrouter/free
NOVEL_AGENT_BASE_URL=https://openrouter.ai/api/v1

# auto: use OpenRouter when a key exists, otherwise use the offline mock.
# openrouter: require OPENROUTER_API_KEY.
# codex: use the local Codex SDK and your existing `codex login` ChatGPT session.
# mock: never access the network.
NOVEL_AGENT_PROVIDER=auto

# Used only by NOVEL_AGENT_PROVIDER=codex. Codex SDK is intended for local,
# coding-focused agents; this provider is an experimental personal-use adapter.
NOVEL_AGENT_CODEX_MODEL=gpt-5.6-terra

NOVEL_AGENT_TIMEOUT_MS=120000
NOVEL_AGENT_MAX_REVISIONS=1
NOVEL_AGENT_MAX_PROVIDER_RETRIES=1
NOVEL_AGENT_OUTPUT_DIR=outputs

# UI messages, prompt instruction locale, and generated novel language are independent.
NOVEL_AGENT_UI_LOCALE=zh-CN
NOVEL_AGENT_PROMPT_LOCALE=zh-CN
NOVEL_AGENT_OUTPUT_LANGUAGE=zh-CN

# false stores model metadata without full prompts, prose, or conversation text.
# Enable only for local debugging with non-sensitive content.
NOVEL_AGENT_TRACE_CONTENT=false
